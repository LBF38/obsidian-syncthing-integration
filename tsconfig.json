{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"types": [
			"svelte",
			"node",
			"@wdio/globals/types",
			"wdio-obsidian-service"
		],
		"baseUrl": ".",
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"strictNullChecks": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"lib": [
			"DOM",
			"ES5",
			"ES6",
			"ES7"
		]
	},
	"include": [
		"**/*.ts",
		"**/*.svelte"
	]
}
